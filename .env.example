# ---------------------------------------------------------------------------
# Copy to .env and fill in the values below:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Server-side GTM -------------------------------------------------------
# GTM Server container → Setup → "Manually provision tagging server" → Container Config.
# Consumed by docker/docker-compose.yml for both the live and preview servers.
# Changing this requires `make down && make up` — it is read at container start.
CONTAINER_CONFIG=

# --- GA4 Measurement Protocol ----------------------------------------------
# GA4 Admin → Data Streams → your web stream → Measurement ID.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# GA4 Admin → Data Streams → your web stream → Measurement Protocol API secrets → Create.
# Secret. Never commit the populated .env (already covered by .gitignore).
GA4_API_SECRET=

# true  → payloads go to /debug/mp/collect and return validation messages.
# false → payloads go to /mp/collect and are actually recorded.
# Keep true while developing; flip to false for the final ingestion run.
GA4_DEBUG=true

# --- Ingestion pipeline ----------------------------------------------------
# Local sGTM live endpoint. Also the transport URL for the web Google Tag.
SGTM_URL=https://localhost

# Routing for the offline CRM path: "direct" sends straight to the Measurement
# Protocol; "sgtm" routes through the local server container instead.
# Document whichever you choose, and why, in LOG.md.
OFFLINE_ROUTE=direct

# Source file for `make ingest`.
CRM_EVENTS_PATH=data/crm_events.json
